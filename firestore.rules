rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath(request.auth.uid));
    }

    function activeUser() {
      return hasProfile() &&
        get(profilePath(request.auth.uid)).data.get('active', false) == true;
    }

    function isAdmin() {
      return activeUser() &&
        get(profilePath(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function ownsOrderData(data) {
      return signedIn() && data.get('workerUid', '') == request.auth.uid;
    }

    function canReadOrderData(data) {
      return activeUser() && (isAdmin() || ownsOrderData(data));
    }

    function validCn(cn) {
      return cn is string && cn.matches('^[A-Z0-9._-]{1,100}$');
    }

    function hasCnReservation(cn, orderId) {
      return validCn(cn) &&
        existsAfter(/databases/$(database)/documents/cnRegistry/$(cn)) &&
        getAfter(/databases/$(database)/documents/cnRegistry/$(cn)).data.get('cn', '') == cn &&
        getAfter(/databases/$(database)/documents/cnRegistry/$(cn)).data.get('orderId', '') == orderId;
    }

    function parentOrderData() {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Admins can provision worker profiles but cannot promote a worker through an update.
      allow create: if isAdmin() &&
        request.resource.data.get('role', '') == 'worker' &&
        request.resource.data.get('active', false) == true;
      allow update: if isAdmin() &&
        request.resource.data.get('role', '') == resource.data.get('role', '');
      allow delete: if isAdmin() && resource.data.get('role', '') == 'worker';
    }

    match /orders/{orderId} {
      allow get, list: if canReadOrderData(resource.data);

      allow create: if activeUser() &&
        hasCnReservation(request.resource.data.get('cn', ''), orderId) &&
        (isAdmin() || ownsOrderData(request.resource.data));

      // CN and assignment are immutable after creation. Changing a CN requires a
      // dedicated atomic reservation migration, not a normal edit.
      allow update: if activeUser() &&
        request.resource.data.get('cn', '') == resource.data.get('cn', '') &&
        request.resource.data.get('workerUid', '') == resource.data.get('workerUid', '') &&
        (isAdmin() || ownsOrderData(resource.data));

      allow delete: if isAdmin();

      match /lcsStatusHistory/{eventId} {
        allow get, list: if canReadOrderData(parentOrderData());

        // History is append-only; an existing event can never be rewritten/deleted.
        allow create: if activeUser() &&
          (isAdmin() || ownsOrderData(getAfter(
            /databases/$(database)/documents/orders/$(orderId)
          ).data));
        allow update, delete: if false;
      }
    }

    match /syncJobs/{jobId} {
      allow get, list: if activeUser() &&
        (isAdmin() || resource.data.get('ownerUid', '') == request.auth.uid);

      allow create: if activeUser() &&
        request.resource.data.get('jobId', '') == jobId &&
        request.resource.data.get('ownerUid', '') == request.auth.uid &&
        request.resource.data.get('isAdmin', false) == isAdmin() &&
        request.resource.data.get('status', '') == 'queued' &&
        request.resource.data.get('total', 0) is int &&
        request.resource.data.get('total', 0) > 0 &&
        request.resource.data.get('completed', -1) == 0 &&
        request.resource.data.get('successful', -1) == 0 &&
        request.resource.data.get('failed', -1) == 0;

      allow update: if activeUser() &&
        (isAdmin() ||
          (resource.data.get('ownerUid', '') == request.auth.uid &&
           request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '') &&
           request.resource.data.get('jobId', '') == resource.data.get('jobId', '') &&
           request.resource.data.get('total', -1) == resource.data.get('total', -2) &&
           request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'completed', 'successful', 'failed', 'status', 'updatedAt', 'finishedAt',
             'stage', 'startedAt', 'matchedOrders', 'matchedTrackingNumbers', 'lastError'
           ]) &&
           request.resource.data.get('completed', -1) is int &&
           request.resource.data.get('successful', -1) is int &&
           request.resource.data.get('failed', -1) is int &&
           request.resource.data.completed >= resource.data.get('completed', 0) &&
           request.resource.data.completed <= resource.data.get('total', 0) &&
           request.resource.data.successful + request.resource.data.failed ==
             request.resource.data.completed &&
           request.resource.data.status in ['queued', 'running', 'completed', 'failed', 'error'] &&
           (!request.resource.data.keys().hasAny(['stage']) ||
             (request.resource.data.stage is string && request.resource.data.stage.size() <= 80)) &&
           (!request.resource.data.keys().hasAny(['lastError']) ||
             (request.resource.data.lastError is string && request.resource.data.lastError.size() <= 1000)) &&
           (!request.resource.data.keys().hasAny(['matchedOrders']) ||
             (request.resource.data.matchedOrders is int && request.resource.data.matchedOrders >= 0)) &&
           (!request.resource.data.keys().hasAny(['matchedTrackingNumbers']) ||
             (request.resource.data.matchedTrackingNumbers is int && request.resource.data.matchedTrackingNumbers >= 0)));

      allow delete: if isAdmin();

      match /items/{itemId} {
        function ownsParentJob() {
          return activeUser() &&
            (isAdmin() ||
              get(/databases/$(database)/documents/syncJobs/$(jobId)).data.get('ownerUid', '') == request.auth.uid);
        }

        function ownsParentJobAfter() {
          return activeUser() &&
            (isAdmin() ||
              getAfter(/databases/$(database)/documents/syncJobs/$(jobId)).data.get('ownerUid', '') == request.auth.uid);
        }

        allow get, list: if ownsParentJob();
        allow create: if ownsParentJobAfter() &&
          request.resource.data.get('cn', '') is string &&
          request.resource.data.get('status', '') == 'pending';
        allow update: if ownsParentJob() &&
          request.resource.data.get('cn', '') == resource.data.get('cn', '') &&
          request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'error', 'completedAt'
          ]) &&
          request.resource.data.get('status', '') in ['pending', 'success', 'failed'];
        allow delete: if isAdmin();
      }
    }

    match /appMeta/{metaId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // CN reservations are write-once for clients; only admins may release one
    // as part of an authorized order deletion.
    match /cnRegistry/{cnKey} {
      allow get: if activeUser();
      allow list: if false;
      allow create: if activeUser() &&
        validCn(cnKey) &&
        !exists(/databases/$(database)/documents/cnRegistry/$(cnKey)) &&
        request.resource.data.get('cn', '') == cnKey &&
        request.resource.data.get('orderId', '') is string &&
        request.resource.data.get('orderId', '') != '' &&
        existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.get('cn', '') == cnKey &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.get('workerUid', '') ==
          request.resource.data.get('workerUid', '') &&
        (isAdmin() || request.resource.data.get('workerUid', '') == request.auth.uid) &&
        request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
